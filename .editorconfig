# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,rs.in}]
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{json,json5}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{js,ts,jsx,tsx}]
indent_style = space
indent_size = 2

[*.{html,css}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

